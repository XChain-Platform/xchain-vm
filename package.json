{
  "name": "xchain-vm",
  "description": "XChain Platform Virtual Machine (VM) runtime — deterministic smart contract execution in sandboxed V8 isolates",
  "version": "1.11.4",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-vm.git"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0",
    "isolated-vm": "^5.0.4",
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/mocha-runner": "^8.7.1",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "scripts": {
    "test": "mocha --timeout 30000 'test/unit/**/*.test.js'",
    "test:all": "mocha --timeout 60000 'test/**/*.test.js'",
    "test:integration": "mocha --timeout 60000 'test/integration/**/*.test.js'",
    "test:boundary": "mocha --timeout 30000 'test/boundary/**/*.test.js'",
    "test:security": "mocha --timeout 30000 'test/security/**/*.test.js'",
    "test:e2e": "mocha --timeout 60000 'test/e2e/**/*.e2e.test.js'",
    "smoke": "mocha --timeout 10000 'test/smoke/**/*.test.js'",
    "test:fuzz": "mocha --timeout 120000 'test/fuzz/**/*.fuzz.test.js'",
    "fuzz": "node test/fuzz/run.js",
    "bench:quick": "node bench/scenarios/pipeline.js && node bench/scenarios/gateway.js",
    "bench:full": "node bench/scenarios/pipeline.js && node bench/scenarios/gateway.js && node bench/scenarios/throughput.js && node bench/scenarios/cache.js",
    "bench:soak": "node bench/scenarios/soak.js",
    "test:chaos": "mocha --timeout 120000 'test/chaos/**/*.chaos.test.js'",
    "test:chaos:quick": "mocha --timeout 60000 'test/chaos/phase1/**/*.chaos.test.js'",
    "test:chaos:phase2": "mocha --timeout 120000 'test/chaos/phase2/**/*.chaos.test.js'",
    "test:chaos:phase3": "mocha --timeout 60000 'test/chaos/phase3/**/*.chaos.test.js'",
    "mutation": "stryker run test/mutation/stryker.config.json",
    "mutation:critical": "stryker run test/mutation/stryker.config.json --mutate 'src/gas.js,src/sandbox.js,src/metering.js,src/index.js'",
    "mutation:high": "stryker run test/mutation/stryker.config.json --mutate 'src/gateway.js,src/gateway-emit.js,src/state.js,src/math.js'",
    "mutation:medium": "stryker run test/mutation/stryker.config.json --mutate 'src/collector.js,src/validator.js,src/syntax.js'",
    "mutation:quick": "stryker run test/mutation/stryker.config.json --mutate 'src/gas.js,src/collector.js,src/errors.js,src/validator.js' --concurrency 2",
    "mutation:custom": "node test/mutation/stryker-xchain-vm-mutator/index.js",
    "mutation:custom:critical": "node test/mutation/stryker-xchain-vm-mutator/index.js --mutate 'src/gas.js,src/sandbox.js,src/metering.js,src/index.js'",
    "mutation:custom:dryrun": "node test/mutation/stryker-xchain-vm-mutator/index.js --dryRun",
    "mutation:report": "node scripts/mutation-report.js",
    "mutation:ci": "stryker run test/mutation/stryker.config.json --incremental --incrementalFile reports/mutation/.stryker-incremental.json",
    "test:regression:smoke": "mocha --timeout 10000 'test/regression/p0-smoke.regression.test.js'",
    "test:regression:core": "mocha --timeout 30000 'test/regression/p0-smoke.regression.test.js' 'test/regression/p1-security.regression.test.js'",
    "test:regression:full": "mocha --timeout 60000 'test/regression/**/*.regression.test.js'",
    "test:regression:nightly": "mocha --timeout 120000 'test/regression/**/*.regression.test.js' 'test/e2e/**/*.e2e.test.js' 'test/fuzz/**/*.fuzz.test.js' 'test/chaos/phase1/**/*.chaos.test.js'",
    "test:regression:release": "npm run test:all && npm run test:fuzz && npm run test:chaos && npm run mutation:critical",
    "test:regression:bugfix": "mocha --timeout 30000 'test/regression/bugs/**/*.test.js'"
  }
}
