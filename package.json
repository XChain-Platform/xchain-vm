{
  "name": "xchain-vm",
  "description": "XChain Platform Virtual Machine (VM) runtime - deterministic smart contract execution in sandboxed V8 isolates",
  "version": "0.9.0",
  "ciPlatform": "linux",
  "license": "AGPL-3.0-or-later",
  "main": "src/index.js",
  "bin": {
    "xchain-lint": "bin/lint.js",
    "xchain-foundry": "bin/xchain-foundry.js",
    "create-xchain-contract": "bin/create-xchain-contract.js"
  },
  "engines": {
    "comment": "Canonical runtime is Node 22 - matches the indexer's node:22-bookworm image and the V8 the validator fleet runs. isolated-vm's native binding is V8-ABI-specific: run `npm rebuild isolated-vm --build-from-source` after switching Node versions. The <23 ceiling is measured, not stylistic: isolated-vm 5.0.4 fails node-gyp on Node 24 on a removed V8 API, so an open-ended range would permit an install right up to the point it cannot compile. See .nvmrc.",
    "node": ">=22.0.0 <23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-Platform/xchain-vm.git"
  },
  "dependencies": {
    "acorn": "8.16.0",
    "acorn-walk": "8.3.5",
    "astring": "1.9.0",
    "isolated-vm": "5.0.4",
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "c8": "^11.0.0",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "fast-uri": "^3.1.5",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "decimal.js": "10.4.3",
    "js-yaml": "^4.3.0"
  },
  "scripts": {
    "test": "mocha --timeout 30000 'test/preflight.test.js' 'test/unit/**/*.test.js' 'test/toolkit/**/*.test.js'",
    "test:toolkit": "mocha --timeout 30000 'test/toolkit/**/*.test.js'",
    "lint": "node bin/lint.js",
    "coverage": "c8 --reporter=text --reporter=html --include 'src/**/*.js' mocha --timeout 30000 'test/preflight.test.js' 'test/unit/**/*.test.js' --exit",
    "coverage:check": "c8 --check-coverage --lines 95.8 --statements 95.8 --branches 85.8 --functions 92.5 --reporter=text-summary --include 'src/**/*.js' mocha --timeout 30000 'test/preflight.test.js' 'test/unit/**/*.test.js' --exit",
    "coverage:subprocess": "c8 --reporter=text --reporter=html --report-dir coverage/subprocess --include 'src/process-executor.js' --include 'src/vm-worker.js' --include 'src/sandbox.js' --include 'src/index.js' mocha --timeout 60000 'test/preflight.test.js' 'test/integration/process-executor.test.js' 'test/integration/subprocess-coverage.test.js' --exit",
    "ci": "mocha --timeout 60000 --exit 'test/preflight.test.js' 'test/unit/**/*.test.js' 'test/smoke/**/*.test.js' 'test/security/**/*.test.js' 'test/boundary/**/*.test.js' 'test/determinism/**/*.test.js' 'test/determinism/known-red/*.known-red.js' 'test/regression/p0-smoke.regression.test.js' 'test/regression/p1-security.regression.test.js' 'test/regression/determinism.test.js' 'test/regression/determinism-baseline.test.js'",
    "test:preflight": "mocha --timeout 30000 'test/preflight.test.js'",
    "test:all": "mocha --timeout 60000 'test/**/*.test.js'",
    "test:integration": "mocha --timeout 60000 'test/preflight.test.js' 'test/integration/**/*.test.js'",
    "test:boundary": "mocha --timeout 30000 'test/preflight.test.js' 'test/boundary/**/*.test.js'",
    "test:security": "mocha --timeout 30000 'test/preflight.test.js' 'test/security/**/*.test.js'",
    "test:performance": "mocha --timeout 60000 'test/performance/**/*.perf.test.js'",
    "test:determinism": "mocha --timeout 60000 'test/preflight.test.js' 'test/determinism/**/*.test.js'",
    "test:known-red": "mocha --timeout 120000 'test/preflight.test.js' 'test/determinism/known-red/*.known-red.js'",
    "test:e2e": "mocha --timeout 60000 'test/preflight.test.js' 'test/e2e/**/*.e2e.test.js'",
    "smoke": "mocha --timeout 10000 'test/preflight.test.js' 'test/smoke/**/*.test.js'",
    "test:fuzz": "mocha --timeout 120000 'test/preflight.test.js' 'test/fuzz/**/*.fuzz.test.js'",
    "test:fuzz:differential": "mocha --timeout 180000 'test/preflight.test.js' 'test/fuzz/differential.fuzz.test.js'",
    "fuzz": "node test/fuzz/run.js",
    "fuzz:differential:record": "node test/fuzz/differential-run.js record",
    "fuzz:differential:verify": "node test/fuzz/differential-run.js verify",
    "fuzz:differential:compare": "node test/fuzz/differential-run.js compare",
    "bench:quick": "node bench/scenarios/pipeline.js && node bench/scenarios/gateway.js",
    "bench:full": "node bench/scenarios/pipeline.js && node bench/scenarios/gateway.js && node bench/scenarios/throughput.js && node bench/scenarios/cache.js",
    "bench:soak": "node bench/scenarios/soak.js",
    "test:soak:executor": "node --expose-gc test/soak/executor-respawn-soak.js",
    "test:chaos": "mocha --timeout 120000 'test/preflight.test.js' 'test/chaos/**/*.chaos.test.js'",
    "test:chaos:quick": "mocha --timeout 60000 'test/preflight.test.js' 'test/chaos/phase1/**/*.chaos.test.js'",
    "test:chaos:phase2": "mocha --timeout 120000 'test/preflight.test.js' 'test/chaos/phase2/**/*.chaos.test.js'",
    "test:chaos:phase3": "mocha --timeout 60000 'test/preflight.test.js' 'test/chaos/phase3/**/*.chaos.test.js'",
    "mutation": "stryker run test/mutation/stryker.config.json",
    "mutation:critical": "stryker run test/mutation/stryker.config.json --mutate 'src/gas.js,src/sandbox.js,src/metering.js,src/index.js'",
    "mutation:high": "stryker run test/mutation/stryker.config.json --mutate 'src/gateway.js,src/gateway-emit.js,src/state.js,src/math.js'",
    "mutation:medium": "stryker run test/mutation/stryker.config.json --mutate 'src/collector.js,src/validator.js,src/syntax.js'",
    "mutation:quick": "stryker run test/mutation/stryker.config.json --mutate 'src/gas.js,src/collector.js,src/errors.js,src/validator.js' --concurrency 2",
    "mutation:custom": "node test/mutation/stryker-xchain-vm-mutator/index.js",
    "mutation:custom:critical": "node test/mutation/stryker-xchain-vm-mutator/index.js --mutate 'src/gas.js,src/sandbox.js,src/metering.js,src/index.js'",
    "mutation:custom:dryrun": "node test/mutation/stryker-xchain-vm-mutator/index.js --dryRun",
    "mutation:report": "node scripts/mutation-report.js",
    "mutation:ci": "stryker run test/mutation/stryker.config.json --incremental --incrementalFile reports/mutation/.stryker-incremental.json",
    "test:regression:smoke": "mocha --timeout 10000 'test/regression/p0-smoke.regression.test.js'",
    "test:regression:core": "mocha --timeout 30000 'test/regression/p0-smoke.regression.test.js' 'test/regression/p1-security.regression.test.js'",
    "test:regression:full": "mocha --timeout 60000 'test/regression/**/*.regression.test.js'",
    "test:regression:nightly": "mocha --timeout 120000 'test/regression/**/*.regression.test.js' 'test/e2e/**/*.e2e.test.js' 'test/fuzz/**/*.fuzz.test.js' 'test/chaos/phase1/**/*.chaos.test.js'",
    "test:regression:release": "npm run test:all && npm run test:fuzz && npm run test:chaos && npm run mutation:critical",
    "test:regression:bugfix": "mocha --timeout 30000 'test/regression/bugs/**/*.test.js'"
  }
}
